<idea-plugin>
    <dependencies>
        <module name="intellij.platform.frontend"/>
        <module name="ocaml.jetbrains.shared"/>
    </dependencies>

    <extensions defaultExtensionNs="com.intellij">
        <projectConfigurable
                id="ocaml.settings"
                parentId="language"
                displayName="OCaml"
                instance="dev.munormae.settings.OCamlSettingsConfigurable"/>
        <newProjectWizard.languageGenerator implementation="dev.munormae.project.OCamlNewProjectWizard"/>
    </extensions>
</idea-plugin>
