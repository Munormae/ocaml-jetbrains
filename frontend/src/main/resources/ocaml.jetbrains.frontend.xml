<idea-plugin>
    <dependencies>
        <module name="intellij.platform.frontend"/>
        <module name="ocaml.jetbrains.shared"/>
    </dependencies>

    <extensions defaultExtensionNs="com.intellij">
        <projectConfigurable
                id="ocaml.settings"
                parentId="language"
                displayName="OCaml"
                instance="dev.munormae.settings.OCamlSettingsConfigurable"/>
        <projectConfigurable
                id="dune.settings"
                parentId="build.tools"
                displayName="Dune"
                instance="dev.munormae.settings.DuneSettingsConfigurable"/>
    </extensions>
</idea-plugin>
